# ---------------------------------------------------------------------------
# Frontend configuration
#
# Copy to .env.local for development. Every value here is public: it is
# compiled into the browser bundle. No secret belongs in this file.
# ---------------------------------------------------------------------------

# Where the FastAPI backend lives. On Vercel, set this to the Render URL.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Only needed if the frontend talks to Supabase directly (Storage, Realtime).
# The anon key is designed to be public and is protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
