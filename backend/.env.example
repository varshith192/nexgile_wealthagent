# ---------------------------------------------------------------------------
# Backend configuration
#
# Every external service below is optional. With this file copied to .env and
# left exactly as-is, the API runs against a local SQLite database with the
# built-in auth provider and the deterministic intelligence layer.
# ---------------------------------------------------------------------------

# -- Application ------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
APP_VERSION=1.0.0

# -- Database ---------------------------------------------------------------
# Local default. For Supabase, paste the Postgres connection string from
# Project Settings → Database → Connection string → URI. Both postgres:// and
# postgresql:// are accepted and normalised automatically.
DATABASE_URL=sqlite:///./nexgile.db
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DB_ECHO=false

# -- Supabase (optional) ----------------------------------------------------
# Only needed when AUTH_PROVIDER=supabase or STORAGE_BACKEND=supabase.
# The service role key is a server-side secret. It must never reach the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=wealthagent-documents

# -- Authentication ---------------------------------------------------------
# local    → issue and verify our own JWTs against the users table (default)
# supabase → verify Supabase Auth access tokens, mapped to the local profile
AUTH_PROVIDER=local
# Generate a real secret for any deployed environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=480
REMEMBER_ME_TTL_MINUTES=43200

# -- Intelligence layer -----------------------------------------------------
# AI_API_KEY is intentionally optional. The product must run without it.
#   mock      → deterministic rules over the real dataset (no key required)
#   anthropic → narration over the same verified figures (key required)
#   openai    → as above
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT_SECONDS=30

# -- Document storage -------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./var/documents
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,xls,xlsx,csv,png,jpg,jpeg,txt,md

# -- CORS -------------------------------------------------------------------
# Comma separated. Any *.vercel.app origin is also allowed by default.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -- Demonstration ----------------------------------------------------------
ENABLE_DEMO_ACCOUNTS=true
DEMO_PASSWORD=Demo1234!
BASE_CURRENCY=USD
