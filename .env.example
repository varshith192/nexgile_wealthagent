# ---------------------------------------------------------------------------
# Nexgile WealthAgent — reference environment
#
# Copy the frontend block to frontend/.env.local and the backend block to
# backend/.env. Never commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# ============================ FRONTEND (Vercel) ============================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ============================= BACKEND (Render) ============================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# The application runs with AI_API_KEY empty. Leave it blank until you have a
# provider; the deterministic rules engine serves every insight until then.
AI_PROVIDER=mock
AI_API_KEY=
